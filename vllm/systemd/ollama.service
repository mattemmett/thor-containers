[Unit]
Description=Ollama (embeddings) on Jetson Thor
Documentation=https://github.com/mattemmett/thor-containers
After=docker.service network-online.target vllm.service
Requires=docker.service
# Ordering matters: vLLM does a strict free-memory check at startup and will
# refuse to launch if Ollama got there first and took a share of unified memory.
# vllm.service holds "activating" until its health endpoint responds, so by the
# time this starts, vLLM's allocation is complete.
Wants=vllm.service network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=15s
TimeoutStartSec=180
TimeoutStopSec=60

Environment=IMAGE=ghcr.io/mattemmett/ollama:v0.20.3-r38-sbsa
Environment=OLLAMA_DATA=/home/matt/ollama-data

ExecStartPre=-/usr/bin/docker rm -f ollama

ExecStart=/usr/bin/docker run --rm \
    --runtime nvidia \
    --network host \
    -v ${OLLAMA_DATA}:/data \
    -e OLLAMA_HOST=0.0.0.0:11434 \
    -e OLLAMA_MODELS=/data/models/ollama/models \
    -e OLLAMA_MAX_LOADED_MODELS=1 \
    -e OLLAMA_KEEP_ALIVE=-1 \
    --name ollama \
    ${IMAGE} \
    /bin/bash -c "exec ollama serve"

# Pin the embedding model in memory so it never unloads and reloads mid-request.
ExecStartPost=/bin/bash -c 'until curl -sf http://localhost:11434/api/version >/dev/null; do sleep 2; done; curl -sf http://localhost:11434/api/generate -d "{\"model\":\"nomic-embed-text\",\"keep_alive\":-1}" >/dev/null || true'

ExecStop=/usr/bin/docker stop --time=30 ollama

[Install]
WantedBy=multi-user.target
